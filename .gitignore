# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/
/private/*
.vscode*
*DS_Store*

# cmd/test_schema_cases 跑用例时生成的导出文件（SQL、编译产物）
/cmd/test_schema_cases/out/

# go build 在仓库根目录留下的可执行文件
# （private/ 下的 main 包也会被 ./... 编到，产物落在当前目录）
/verify_baseline
/readme_check
/readme_check2
